rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Template: the live rules in the Firebase console contain the real addresses.
    // Only these Google accounts can read or write. Use lowercase emails.
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'person1@gmail.com',
          'person2@gmail.com'
        ];
    }

    match /households/{household}/{document=**} {
      allow read, write: if isFamily();
    }
  }
}
